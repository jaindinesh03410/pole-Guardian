VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── WhatsApp Alerts (Twilio) ──────────────────────────────────────────────
# URL of your deployed Firebase Cloud Function (sendWhatsAppAlert).
# Leave blank to disable the frontend fallback (Firestore trigger still fires for real data).
# Example: https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/sendWhatsAppAlert
VITE_WHATSAPP_FUNCTION_URL=

# Shared secret passed as x-alert-secret header to the Cloud Function.
# Must match the value set via: firebase functions:config:set alert.secret="your_secret"
# Leave blank to disable auth on the HTTP endpoint (not recommended for production).
VITE_ALERT_SECRET=
